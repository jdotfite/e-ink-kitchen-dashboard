# Copy to .env on the Raspberry Pi and fill in real values. Do not commit .env.
OPENWEATHER_API_KEY=
OPENWEATHER_LATITUDE=
OPENWEATHER_LONGITUDE=
DASHBOARD_LOCATION=Home
OPENWEATHER_UNITS=imperial
# 0=Monday, 6=Sunday. Example: Wednesday and Sunday -> 2,6
TRASH_DAYS=
CSV_ENABLED=true
REQUEST_CONNECT_TIMEOUT=5
REQUEST_READ_TIMEOUT=20
# Google Calendar private iCal URL (Calendar Settings > "Secret address in iCal format").
GOOGLE_CALENDAR_ICAL_URL=
# Comma-separated stock tickers to display (e.g. AAPL,MSFT,GOOG).
STOCK_TICKERS=
# Optional legacy endpoint returning calendar/facts JSON (calendar is ignored if GOOGLE_CALENDAR_ICAL_URL is set).
DASHBOARD_API_URL=
# Auth token sent as x-eink-token header to DASHBOARD_API_URL.
EINK_API_TOKEN=
